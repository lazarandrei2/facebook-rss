{
  "name": "feeder",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Scrape Facebook and X/Twitter profiles into RSS feeds (facebook.xml + twitter.xml)",
  "bin": {
    "facebook-rss": "./bin/cli.js"
  },
  "scripts": {
    "login": "node --disable-warning=ExperimentalWarning bin/cli.js login",
    "fetch": "node --disable-warning=ExperimentalWarning bin/cli.js fetch",
    "clean": "node --disable-warning=ExperimentalWarning bin/cli.js clean",
    "publish": "node --disable-warning=ExperimentalWarning bin/cli.js publish",
    "serve": "node --disable-warning=ExperimentalWarning bin/cli.js serve",
    "watch": "./bin/run-loop.sh start",
    "watch:logs": "./bin/run-loop.sh logs",
    "watch:status": "./bin/run-loop.sh status",
    "watch:stop": "./bin/run-loop.sh stop",
    "test": "node --disable-warning=ExperimentalWarning test/media.test.js && node --disable-warning=ExperimentalWarning test/twitter-thread.test.js && node --disable-warning=ExperimentalWarning test/config.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "playwright": "^1.54.2"
  }
}
